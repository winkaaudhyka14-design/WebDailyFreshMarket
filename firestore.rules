rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { 
      return request.resource.data; 
    }

    function isSignedIn() { 
      return request.auth != null; 
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'tgl_masuk', 'tgl_expired', 'imageUrls']) &&
             data.id is string &&
             data.name is string &&
             data.category is string &&
             data.tgl_masuk is string &&
             data.tgl_expired is string &&
             data.imageUrls is list;
    }

    match /products/{productId} {
      // Products can be read by anyone (public landing page)
      allow read: if true;
      
      // Only authenticated users can write products
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isSignedIn() && isValidId(productId);
    }
    
    match /users/{userId} {
      // Only authenticated users can read/write users collection
      allow read, write: if isSignedIn();
    }

    match /sales/{saleId} {
      allow read, write: if isSignedIn();
    }
  }
}
